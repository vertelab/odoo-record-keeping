<odoo>
    <record id="view_attachment_form" model="ir.ui.view">
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <label for="name" position="before">
                <!-- #if VERSION <= "16.0" -->
                <widget name="web_ribbon" title="Confidential" bg_color="bg-danger" attrs="{'invisible': [('is_secret', '=', False)]}" />
                <!-- #elif VERSION >= "17.0" -->
                <widget name="web_ribbon" title="Confidential" bg_color="bg-danger" invisible="not is_secret"/>
                <!-- #endif -->
            </label>
            <field name="mimetype" position="after">
                <!-- #if VERSION <= "16.0" -->
                <field name="matter_id" attrs="{'invisible':[('document_ref', '=', False)]}" />
                <!-- #elif VERSION >= "17.0" -->
                <field name="matter_id" invisible="not document_ref"/>
                <!-- #endif -->
                <field name="classification_id" domain="[('has_types', '=', True)]"/>
                <field name="document_type_id" domain="[('classification_id', '=', classification_id)]"/>
            </field>
            <sheet position="before">
                <header>
                    <!-- #if VERSION <= "16.0" -->
                    <button name="%(record_keeping.action_add_record_wizard)d" string="Link to record" type="action" attrs="{'invisible': [('matter_id', '!=', False)]}" />
                    <!-- #elif VERSION >= "17.0" -->
                    <button name="%(record_keeping.action_add_record_wizard)d" string="Link to record" type="action" invisible="matter_id"/>
                    <!-- #endif -->
                </header>
            </sheet>
            <!-- #if VERSION <= "16.0" -->
            <notebook position="inside">
            <!-- #elif VERSION >= "17.0" -->
            <group groups="base.group_no_one" position="after">
              <notebook>
            <!-- #endif -->
                <page name="record_keeping" string="Record-keeping">
                    <group>
                        <group>
                            <field name="draw_up_receive_date" widget="date"/>
                            <field name="receiver"/>
                            <field name="sender"/>
                        </group>
                        <group>
                            <!-- #if VERSION <= "16.0" -->
                            <field name="document_ref" attrs="{'invisible':[('is_official', '=', False)]}" class="oe_read_only" />
                            <field name="rk_file_name" />
                            <field name="is_official" />
                            <field name="is_secret" attrs="{'invisible':[('is_official', '=', False)]}" />
                            <field name="law_section_id" attrs="{'invisible': ['|', ('is_official', '=', False), ('is_secret', '=', False)], 'required': [('is_secret', '=', True)]}" />
                            <field name="secrecy_grounds" attrs="{'invisible': ['|', ('is_official', '=', False), ('is_secret', '=', False)]}" />
                            <!-- #elif VERSION >= "17.0" -->
                            <field name="document_ref" invisible="not is_official" class="oe_read_only"/>
                            <field name="rk_file_name"/>
                            <field name="is_official"/>
                            <field name="is_secret" invisible="not is_official"/>
                            <field name="law_section_id" invisible="not is_official or not is_secret" required="is_secret"/>
                            <field name="secrecy_grounds" invisible="not is_official or not is_secret"/>
                            <!-- #endif -->
                        </group>
                    </group>
                </page>
                <page name="meta_information" string="Meta Information">
                    <group>
                        <group>
                            <field name="create_date" widget="date"/>
                            <field name="create_uid"/>
                        </group>
                        <group>
                            <field name="write_date" widget="date"/>
                            <field name="write_uid"/>
                        </group>
                    </group>
                </page>
            <!-- #if VERSION <= "16.0" -->
            </notebook>
            <!-- #elif VERSION >= "17.0" -->
              </notebook>
            </group>
            <!-- #endif -->
            <sheet position="after">
                <!-- #if VERSION <= "17.0" -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" options="{'post_refresh':True}" groups="base.group_user" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
                <!-- #elif VERSION >= "18.0" -->
                <chatter/>
                <!-- #endif -->
            </sheet>
        </field>
    </record>
</odoo>
<odoo>

    <record id="sale_order_form_quote" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">
            <header position="inside">
                <!-- #if VERSION <= "16.0" -->
                <button name="%(record_keeping.action_add_record_wizard)d" attrs="{'invisible':[('matter_id', '!=', False)]}" string="Link to record" type="action" />
                <!-- #elif VERSION >= "17.0" -->
                <button name="%(record_keeping.action_add_record_wizard)d" invisible="matter_id" string="Link to record" type="action"/>
                <!-- #endif -->
            </header>
            <div name="button_box" position="after">
                <!-- #if VERSION <= "16.0" -->
                <widget name="web_ribbon" attrs="{'invisible': [('is_secret', '=', False)]}" bg_color="bg-danger" title="Confidential" />
                <!-- #elif VERSION >= "17.0" -->
                <widget name="web_ribbon" invisible="not is_secret" bg_color="bg-danger" title="Confidential"/>
                <!-- #endif -->
            </div>
            <field name="sale_order_template_id" position="after">
                <!-- #if VERSION <= "16.0" -->
                <field name="matter_id" attrs="{'invisible':[('document_ref', '=', False)]}" />
                <!-- #elif VERSION >= "17.0" -->
                <field name="matter_id" invisible="not document_ref"/>
                <!-- #endif -->
                <field name="classification_id" domain="[('has_types', '=', True)]"/>
                <field name="document_type_id" domain="[('classification_id', '=', classification_id)]"/>
            </field>
            <notebook position="inside">
                <page name="record_keeping" string="Record-keeping">
                    <group>
                        <group>
                            <field name="draw_up_receive_date" widget="date"/>
                            <!-- <field name="receive_date" widget="date" /> -->
                            <field name="receiver"/>
                            <field name="sender"/>
                        </group>
                        <group>
                            <!-- #if VERSION <= "16.0" -->
                            <field name="document_ref" attrs="{'invisible': [('is_official', '=', False)]}" class="oe_read_only" />
                            <field name="is_official" />
                            <field name="is_secret" attrs="{'invisible': [('is_official', '=', False)]}" />
                            <field name="law_section_id" attrs="{
                                'invisible': ['|', 
                                    ('is_official', '=', False), 
                                    ('is_secret', '=', False)
                                ],
                                'required': [('is_secret', '=', True)]}" />
                            <field name="secrecy_grounds" attrs="{
                                'invisible': ['|', 
                                    ('is_official', '=', False), 
                                    ('is_secret', '=', False)
                                ]}" />
                            <!-- #elif VERSION >= "17.0" -->
                            <field name="document_ref" invisible="not is_official" class="oe_read_only"/>
                            <field name="is_official"/>
                            <field name="is_secret" invisible="not is_official"/>
                            <field name="law_section_id" invisible="not is_official or not is_secret" required="is_secret"/>
                            <field name="secrecy_grounds" invisible="not is_official or not is_secret"/>
                            <!-- #endif -->
                        </group>
                    </group>
                </page>
                <page name="meta_information" string="Meta Information">
                    <group>
                        <group>
                            <field name="create_date" widget="date"/>
                            <field name="create_uid"/>
                        </group>
                        <group>
                            <field name="write_date" widget="date"/>
                            <field name="write_uid"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
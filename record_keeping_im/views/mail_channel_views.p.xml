<odoo>
    <!-- #if VERSION <= "16.0" -->
     <record id="mail_channel_view_form" model="ir.ui.view">
        <field name="model">mail.channel</field>
        <field name="inherit_id" ref="im_livechat.mail_channel_view_form" />
    <!-- #elif VERSION >= "17.0" -->
     <record id="discuss_channel_view_form" model="ir.ui.view">
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="im_livechat.discuss_channel_view_form"/>
    <!-- #endif -->
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <field name="matter_id" invisible="1"/>
                    <!-- #if VERSION <= "16.0" -->
                    <button name="%(record_keeping.action_add_record_wizard)d" attrs="{'invisible':[('matter_id', '!=', False)]}" string="Link to record" type="action" />
                    <!-- #elif VERSION >= "17.0" -->
                    <button name="%(record_keeping.action_add_record_wizard)d" invisible="matter_id" string="Link to record" type="action"/>
                    <!-- #endif -->
                </header>
            </sheet>
            <!-- #if VERSION <= "15.0" -->
            <xpath expr="//div[hasclass('float-right')]" position="before">
                <widget name="web_ribbon" title="Confidential" bg_color="bg-danger" attrs="{'invisible': [('is_secret', '=', False)]}" />
            <!-- #elif VERSION >= "16.0" -->
            <xpath expr="//div[hasclass('float-end')]" position="before">
                <widget name="web_ribbon" title="Confidential" bg_color="bg-danger" invisible="not is_secret"/>
            <!-- #endif -->
            </xpath>
            <!-- #if VERSION <= "17.0" -->
            <xpath expr="//group[hasclass('o_history_container')]" position="after">
            <!-- #elif VERSION >= "18.0" -->
            <group position="after">
            <!-- #endif -->
                <notebook>
                    <page name="record_keeping" string="Record-keeping">
                        <group>
                            <group>
                                <field name="draw_up_receive_date" widget="date"/>
                                <field name="receive_date" widget="date"/>
                                <field name="receiver"/>
                                <field name="sender"/>
                            </group>
                            <group>
                                <!-- #if VERSION <= "16.0" -->
                                <field name="document_ref" attrs="{'invisible':[('is_official', '=', False)]}" class="oe_read_only" />
                                <field name="is_official" />
                                <field name="is_secret" attrs="{'invisible':[('is_official', '=', False)]}" />
                                <field name="law_section_id" attrs="{'invisible': ['|', ('is_official', '=', False), ('is_secret', '=', False)], 'required': [('is_secret', '=', True)]}" />
                                <field name="secrecy_grounds" attrs="{'invisible': ['|', ('is_official', '=', False), ('is_secret', '=', False)]}" />
                                <!-- #elif VERSION >= "17.0" -->
                                <field name="document_ref" invisible="not is_official" class="oe_read_only"/>
                                <field name="is_official"/>
                                <field name="is_secret" invisible="not is_official"/>
                                <field name="law_section_id" invisible="not is_official or not is_secret" required="is_secret"/>
                                <field name="secrecy_grounds" invisible="not is_official or not is_secret"/>
                                <!-- #endif -->
                            </group>
                        </group>
                    </page>
                    <page name="meta_information" string="Meta Information">
                        <group>
                            <group>
                                <field name="create_date" widget="date"/>
                                <field name="create_uid"/>
                            </group>
                            <group>
                                <field name="write_date" widget="date"/>
                                <field name="write_uid"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            <!-- #if VERSION <= "17.0" -->
            </xpath>
            <!-- #elif VERSION >= "18.0" -->
            </group>
            <!-- #endif -->
        </field>
    </record>

    <!-- #if VERSION <= "16.0" -->
    <record id="mail_channel_view_tree" model="ir.ui.view">
        <field name="model">mail.channel</field>
        <field name="inherit_id" ref="im_livechat.mail_channel_view_tree" />
    <!-- #elif VERSION >= "17.0" -->
    <record id="discuss_channel_view_tree" model="ir.ui.view">
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="im_livechat.discuss_channel_view_tree"/>
    <!-- #endif -->
        <field name="arch" type="xml">
            <field name="rating_last_image" position="after">
                <field name="matter_id"/>
            </field>
        </field>
    </record>

</odoo>
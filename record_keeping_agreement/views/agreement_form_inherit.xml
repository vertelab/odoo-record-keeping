<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="rk_agreement_form_inherit_record_keeping" model="ir.ui.view">
      <field name="name">record_keeping_agreement.agreement.form.inherit.record.keeping</field>
      <field name="model">agreement</field>
      <field name="inherit_id" ref="agreement.agreement_form"/>
      <field name="arch" type="xml">

        <sheet position="before">

          <header>
            <button name="create_matter"
                    type="object"
                    string="Create Matter"
                    class="oe_stat_button oe_highlight"
                    invisible="matter_id"/>
            <button name="%(record_keeping.action_add_record_wizard)d"
                    type="action"
                    string="Link to record"
                    class="oe_stat_button"
                    invisible="matter_id"/>
          </header>
        </sheet>


         <page name="config" position="after">

            <page name="record_keeping" string="Record-keeping" invisible="not matter_id">
              <group>
                <group>
                  <field name="matter_id" invisible="not document_ref"/>
                  <field name="classification_id"
                         domain="[('has_types', '=', True)]"/>
                  <field name="document_type_id"
                         domain="[('classification_id', '=', classification_id)]"/>
                </group>
              </group>

              <group>
                <group>
                  <field name="draw_up_receive_date" widget="date"/>
                  <field name="receiver"/>
                  <field name="sender"/>
                </group>
                <group>
                  <field name="document_ref"
                         invisible="not is_official"
                         class="oe_read_only"/>
                  <field name="is_official"/>
                  <field name="is_secret" invisible="not is_official"/>
                  <field name="law_section_id"
                         invisible="not is_official or not is_secret"
                         required="is_secret"/>
                  <field name="secrecy_grounds"
                         invisible="not is_official or not is_secret"/>
                </group>
              </group>
            </page>

          </page>

      </field>
    </record>

  </data>
</odoo>


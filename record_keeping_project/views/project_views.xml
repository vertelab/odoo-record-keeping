<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="%(record_keeping.action_add_record_wizard)d" string="Link to record" type="action" invisible="matter_id"/>
            </header>
            <widget position="replace">
                <widget name="web_ribbon" bg_color="bg-danger" title="Confidential" invisible="not is_secret"/>
            </widget>
            <div class="oe_title" position="after">
                <group>
                    <group>
                        <field name="matter_id" invisible="not document_ref"/>
                        <field name="classification_id" domain="[('has_types', '=', True)]"/>
                        <field name="document_type_id" domain="[('classification_id', '=', classification_id)]"/>
                    </group>
                </group>
            </div>
            <notebook position="inside">
                <page name="record_keeping" string="Record-keeping">
                    <group>
                        <group>
                            <field name="draw_up_receive_date" widget="date"/>
                            <!-- <field name="receive_date" widget="date" /> -->
                            <field name="receiver"/>
                            <field name="sender"/>
                        </group>
                        <group>
                            <field name="document_ref" invisible="not is_official" class="oe_read_only"/>
                            <field name="is_official"/>
                            <field name="is_secret" invisible="not is_official"/>
                            <field name="law_section_id" invisible="not is_official or not is_secret" required="is_secret"/>
                            <field name="secrecy_grounds" invisible="not is_official or not is_secret"/>
                        </group>
                    </group>
                </page>
                <page name="meta_information" string="Meta Information">
                    <group>
                        <group>
                            <field name="create_date" widget="date"/>
                            <field name="create_uid"/>
                        </group>
                        <group>
                            <field name="write_date" widget="date"/>
                            <field name="write_uid"/>
                        </group>
                    </group>
                </page>
            </notebook>
             <div class="oe_chatter" position="replace" />
            <sheet position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" help="Follow this project to automatically track the events associated to tasks and issues of this project." options="{'post_refresh': True}" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </sheet>
        </field>
    </record>

    <record id="view_project_kanban" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <field name="user_id" position="before">
                <field name="is_official" invisible="1"/>
                <field name="document_id" invisible="not is_official" decoration-success="1" widget="badge"/>
            </field>
        </field>
    </record>

    <record id="view_project_project_filter" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="document_id" filter_domain="[('is_official', '=', True), ('document_id', 'like', self)]" string="Registration number"/>
            </search>
        </field>
    </record>
</odoo>

<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <header position="inside">
                <!-- #if VERSION <= "16.0" -->
                <button name="create_matter" class="oe_highlight" string="Create Matter" type="object" attrs="{
                    'invisible': [('matter_id', '!=', False)]}" />
                <button name="%(record_keeping.action_add_record_wizard)d" string="Link to record" type="action" attrs="{
                    'invisible': [('matter_id', '!=', False)]}" />
                <!-- #elif VERSION >= "17.0" -->
                <button name="create_matter" class="oe_highlight" string="Create Matter" type="object" invisible="matter_id"/>
                <button name="%(record_keeping.action_add_record_wizard)d" string="Link to record" type="action" invisible="matter_id"/>
                <!-- #endif -->
            </header>
            <widget position="replace">
                <!-- #if VERSION <= "16.0" -->
                <widget name="web_ribbon" attrs="{'invisible': [('is_secret', '=', False)]}" bg_color="bg-danger" title="Confidential" />
                <!-- #elif VERSION >= "17.0" -->
                <widget name="web_ribbon" invisible="not is_secret" bg_color="bg-danger" title="Confidential"/>
                <!-- #endif -->
            </widget>
            <field name="partner_id" position="before">
                <!-- #if VERSION <= "16.0" -->
                <field name="matter_id" attrs="{'invisible': [('document_ref', '=', False)]}" />
                <!-- #elif VERSION >= "17.0" -->
                <field name="matter_id" invisible="not document_ref"/>
                <!-- #endif -->
                <field name="classification_id" domain="[('has_types', '=', True)]"/>
                <field name="document_type_id" domain="[('classification_id', '=', classification_id)]"/>
            </field>
            <notebook position="inside">
                <page name="record_keeping" string="Record-keeping">
                    <group>
                        <group>
                            <field name="draw_up_receive_date" widget="date"/>
                            <!-- <field name="receive_date" widget="date" /> -->
                            <field name="receiver"/>
                            <field name="sender"/>
                        </group>
                        <group>
                            <!-- #if VERSION <= "16.0" -->
                            <field name="document_ref" attrs="{'invisible': [('is_official', '=', False)]}" class="oe_read_only" />
                            <field name="is_official" />
                            <field name="is_secret" attrs="{'invisible':[('is_official', '=', False)]}" />
                            <field name="law_section_id" attrs="{
                                'invisible': ['|', 
                                    ('is_official', '=', False), 
                                    ('is_secret', '=', False)], 
                                'required': [('is_secret', '=', True)]}" />
                            <field name="secrecy_grounds" attrs="{
                                'invisible': ['|', 
                                    ('is_official', '=', False), 
                                   ('is_secret', '=', False)]}" />
                            <!-- #elif VERSION >= "17.0" -->
                            <field name="document_ref" invisible="not is_official" class="oe_read_only"/>
                            <field name="is_official"/>
                            <field name="is_secret" invisible="not is_official"/>
                            <field name="law_section_id" invisible="not is_official or not is_secret" required="is_secret"/>
                            <field name="secrecy_grounds" invisible="not is_official or not is_secret"/>
                            <!-- #endif -->
                        </group>
                    </group>
                </page>
                <page name="meta_information" string="Meta Information">
                    <group>
                        <group>
                            <field name="create_date" widget="date"/>
                            <field name="create_uid"/>
                        </group>
                        <group>
                            <field name="write_date" widget="date"/>
                            <field name="write_uid"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_task_kanban" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <!-- #if VERSION <= "17.0" -->
            <div class="o_kanban_record_top" position="after">
                <field name="is_official" invisible="1" />
                <field name="document_id" attrs="{'invisible': [('is_official', '=', False)]}" decoration-success="1" widget="badge" />
            </div>
            <!-- #elif VERSION >= "18.0" -->
            <field name="milestone_id" position="after">
                <field name="is_official" invisible="1"/>
                <field name="document_id" invisible="not is_official" decoration-success="1" widget="badge"/>
            </field>
            <!-- #endif -->
        </field>
    </record>

    <record id="view_task_search_form" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="document_id" filter_domain="[('is_official', '=', True), ('document_id', 'like', self)]" string="Registration number"/>
            </search>
        </field>
    </record>
</odoo>